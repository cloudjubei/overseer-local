  "info": {
    "title": "compass-backend",
    "description": "API documentation for the Compass Backend",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 6
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "RegisterResultDto": {
        "type": "object",
        "properties": {
          "userSub": {
            "type": "string",
            "description": "User unique id (sub)"
          },
          "userConfirmed": {
            "type": "boolean",
            "description": "Whether the user is confirmed and can login"
          }
        },
        "required": [
          "userSub",
          "userConfirmed"
        ]
      },
      "ConfirmSignUpDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "confirmationCode": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "confirmationCode"
        ]
      },
      "StatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "OK"
          }
        },
        "required": [
          "status"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "LoginResultDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "JWT ID token"
          },
          "accessToken": {
            "type": "string",
            "description": "JWT access token"
          },
          "refreshToken": {
            "type": "string",
            "description": "Refresh token if provided by auth provider"
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until token expiry"
          },
          "tokenType": {
            "type": "string",
            "description": "Token type, e.g., Bearer"
          }
        },
        "required": [
          "idToken",
          "accessToken"
        ]
      },
      "TelegramLoginDto": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "description": "Telegram user id"
          },
          "accessCode": {
            "type": "string",
            "description": "Pairing/access code provided by backend"
          },
          "secret": {
            "type": "string",
            "description": "Shared secret from Telegram bot/app"
          }
        },
        "required": [
          "externalId",
          "accessCode",
          "secret"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ]
      },
      "ConfirmForgotPasswordDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "confirmationCode": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "username",
          "confirmationCode",
          "newPassword"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Access token of the authenticated session"
          },
          "previousPassword": {
            "type": "string",
            "minLength": 6
          },
          "proposedPassword": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "accessToken",
          "previousPassword",
          "proposedPassword"
        ]
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "User id"
          },
          "dob": {
            "type": "string",
            "description": "Date of birth (YYYY-MM-DD)"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER"
            ]
          }
        },
        "required": [
          "id"
        ]
      },
      "CreateProfileDto": {
        "type": "object",
        "properties": {
          "dob": {
            "type": "string",
            "description": "Date of birth (YYYY-MM-DD)",
            "example": "1990-01-01"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER"
            ]
          }
        }
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "dob": {
            "type": "string",
            "description": "Date of birth (YYYY-MM-DD)",
            "example": "1990-01-01"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER"
            ]
          }
        }
      },
      "CreateMoodDto": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "score"
        ]
      },
      "CreateGoalDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "MACRO",
              "MICRO",
              "OTHER"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "FITNESS",
              "SLEEP",
              "FOCUS",
              "STRESS",
              "OTHER"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "EASY",
              "MEDIUM",
              "HARD",
              "OTHER"
            ]
          },
          "text": {
            "type": "string"
          },
          "moods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateMoodDto"
            }
          },
          "rating": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "category",
          "difficulty",
          "text"
        ]
      },
      "UserMoodDto": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO8601 timestamp when the mood was recorded"
          }
        },
        "required": [
          "score",
          "createdAt"
        ]
      },
      "GoalDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Goal id (UUID)"
          },
          "userId": {
            "type": "string",
            "description": "Owner user id"
          },
          "type": {
            "type": "string",
            "enum": [
              "MACRO",
              "MICRO",
              "OTHER"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "FITNESS",
              "SLEEP",
              "FOCUS",
              "STRESS",
              "OTHER"
            ]
          },
          "difficulty": {
