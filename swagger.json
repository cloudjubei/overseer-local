    "/goals/suggestions": {
      "get": {
        "operationId": "GoalsController_paramSuggestions",
        "summary": "Get parameterized goal suggestions (non-AI)",
        "parameters": [
          {
            "name": "type",
            "required": true,
            "in": "query",
            "schema": {
              "enum": [
                "MACRO",
                "MICRO",
                "OTHER"
              ],
              "type": "string"
            }
          },
          {
            "name": "category",
            "required": true,
            "in": "query",
            "schema": {
              "enum": [
                "FITNESS",
                "SLEEP",
                "FOCUS",
                "STRESS",
                "OTHER"
              ],
              "type": "string"
            }
          },
          {
            "name": "difficulty",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "EASY",
                "MEDIUM",
                "HARD",
                "OTHER"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SuggestedGoalDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "goals"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
