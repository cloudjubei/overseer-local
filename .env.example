# Environment variables for Compass Telegram Bot
# Copy this file to .env and fill in the values.
# You can also create a .env.local file to override values locally (ignored by git).

# Required: Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Required: Shared secret used to authenticate with the backend
BACKEND_SHARED_SECRET=

# Optional: Base URL of the backend API (defaults to http://localhost:3000)
BACKEND_BASE_URL=http://localhost:3000

# Optional: Node environment (development | test | production)
NODE_ENV=development

# Optional: Timezone for scheduled jobs (defaults to UTC)
TZ=UTC
