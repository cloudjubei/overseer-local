{
  "name": "compass-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript-based Telegram bot that relies on a generated backend client from swagger.json.",
  "type": "module",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start:dev": "tsx src/index.ts",
    "start:ts-node": "ts-node --esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "generate:backend": "openapi -i ./swagger.json -o ./src/generated/backend -c axios --useOptions",
    "pm2:start:tsx": "pm2 start 'npx tsx src/index.ts' --name compass-bot",
    "pm2:start:ts-node": "pm2 start 'npx ts-node --esm src/index.ts' --name compass-bot"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "openapi-typescript-codegen": "^0.29.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
