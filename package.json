{
  "name": "compass-telegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:backend": "openapi --input ./swagger.json --output ./src/generated/backend --client axios --useOptions",
    "format": "prettier --write .",
    "dev": "nodemon --watch src --ext ts,tsx --exec ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "prettier": "^3.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/node-telegram-bot-api": "^0.64.11",
    "nodemon": "^3.1.7",
    "openapi-typescript-codegen": "^0.29.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
